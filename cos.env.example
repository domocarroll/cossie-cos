# Cossie v2 — Environment configuration
# Copy to ~/.config/cossie/cos.env and source from your shell profile
# Or set these variables directly in your shell

# Krang project management
COS_KRANG_DIR="$HOME/projects/huly-sdk-explorer"
# COS_KRANG_BIN="$COS_KRANG_DIR/bin/krang.js"

# Infrastructure SSH access
COS_SSH_KEY="$HOME/.ssh/id_rsa"
COS_SSH_HOST="root@your-server-ip"
